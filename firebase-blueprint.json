{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information, role, and super admin approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["student", "organizer", "admin", "canteen"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "phone": { "type": "string", "maxLength": 30 },
        "college": { "type": "string", "maxLength": 150 },
        "course": { "type": "string", "maxLength": 150 },
        "interests": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "societyId": { "type": "string", "maxLength": 128 },
        "followedSocieties": { "type": "array", "items": { "type": "string" } },
        "photoURL": { "type": "string", "maxLength": 500000 },
        "vendorName": { "type": "string", "maxLength": 150 },
        "organisation": { "type": "string", "maxLength": 150 },
        "upiId": { "type": "string", "maxLength": 120 },
        "razorpayId": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "events": {
      "title": "Event",
      "description": "Campus event details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "format": "date-time" },
        "venue": { "type": "string", "maxLength": 200 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "societyId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "enum": ["free", "paid"] },
        "fee": { "type": "number" },
        "couponCost": { "type": "number" },
        "maxCoupons": { "type": "number" },
        "registrationLimit": { "type": "number" },
        "registeredCount": { "type": "number" },
        "posterUrl": { "type": "string", "maxLength": 700000 },
        "slug": { "type": "string", "maxLength": 220 },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed"] },
        "hasFoodCoupon": { "type": "boolean" },
        "isCanteenPaymentDone": { "type": "boolean" },
        "qrVisible": { "type": "boolean" },
        "qrExpiry": { "type": "string" },
        "qrScanLimit": { "type": "number" },
        "qrScanStart": { "type": "string" },
        "qrScanEnd": { "type": "string" },
        "couponsDistributed": { "type": "boolean" },
        "upiId": { "type": "string", "maxLength": 120 }
      },
      "required": ["title", "description", "date", "venue", "organizerId", "category", "type", "registrationLimit", "registeredCount", "status"]
    },
    "registrations": {
      "title": "Registration",
      "description": "Student registration for an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected"] },
        "paymentId": { "type": "string" },
        "transactionId": { "type": "string" },
        "paymentScreenshot": { "type": "string" },
        "ticketId": { "type": "string" },
        "attended": { "type": "boolean" },
        "couponRedeemed": { "type": "boolean" },
        "couponRedeemedAt": { "type": "string" },
        "qrCode": { "type": "string" },
        "scannedAt": { "type": "string", "format": "date-time" },
        "couponActive": { "type": "boolean" },
        "validationToken": { "type": "string" }
      },
      "required": ["userId", "eventId", "status", "attended", "couponRedeemed"]
    },
    "societies": {
      "title": "Society",
      "description": "Campus society details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 60 },
        "logoUrl": { "type": "string", "maxLength": 500000 },
        "bannerUrl": { "type": "string", "maxLength": 700000 },
        "followerCount": { "type": "number" },
        "organizerId": { "type": "string" }
      },
      "required": ["name", "description", "category", "organizerId"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Attendance log for events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "scanTime": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["userId", "eventId", "scanTime"]
    },
    "coupons": {
      "title": "CouponRedemption",
      "description": "Log of food coupon redemptions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "vendorId": { "type": "string" }
      },
      "required": ["userId", "eventId", "redeemedAt", "vendorId"]
    },
    "payments": {
      "title": "CanteenPayment",
      "description": "Payment from organizer to canteen vendor",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "organizerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorUpiId": { "type": "string" },
        "amount": { "type": "number" },
        "studentCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "paid", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" },
        "razorpayPaymentId": { "type": "string" },
        "upiTransactionId": { "type": "string" },
        "paymentScreenshot": { "type": "string" }
      },
      "required": ["eventId", "organizerId", "amount", "status", "requestedAt"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Role-based real-time notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 60 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read"]
    },
    "settings": {
      "title": "PlatformSettings",
      "description": "Super admin global platform settings",
      "type": "object",
      "properties": {
        "requireStudentApproval": { "type": "boolean" },
        "requireOrganizerApproval": { "type": "boolean" },
        "requireCanteenApproval": { "type": "boolean" },
        "platformUpiId": { "type": "string" },
        "supportEmail": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "User profiles"
    },
    "events/{eventId}": {
      "schema": "events",
      "description": "Event documents"
    },
    "registrations/{registrationId}": {
      "schema": "registrations",
      "description": "Event registrations"
    },
    "societies/{societyId}": {
      "schema": "societies",
      "description": "Society documents"
    },
    "attendance/{attendanceId}": {
      "schema": "attendance",
      "description": "Attendance logs"
    },
    "coupons/{couponId}": {
      "schema": "coupons",
      "description": "Coupon redemptions"
    },
    "payments/{paymentId}": {
      "schema": "payments",
      "description": "Canteen payments"
    },
    "notifications/{notificationId}": {
      "schema": "notifications",
      "description": "User notifications"
    },
    "settings/{settingId}": {
      "schema": "settings",
      "description": "Platform configuration"
    }
  }
}
