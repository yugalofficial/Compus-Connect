{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information, role, and super admin approval status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["student", "organizer", "admin", "canteen"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "phone": { "type": "string", "maxLength": 30 },
        "college": { "type": "string", "maxLength": 150 },
        "course": { "type": "string", "maxLength": 150 },
        "interests": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "societyId": { "type": "string", "maxLength": 128 },
        "followedSocieties": { "type": "array", "items": { "type": "string" } },
        "photoURL": { "type": "string", "maxLength": 500000 },
        "vendorName": { "type": "string", "maxLength": 150 },
        "organisation": { "type": "string", "maxLength": 150 },
        "upiId": { "type": "string", "maxLength": 120 },
        "razorpayId": { "type": "string", "maxLength": 120 },
        "notificationPreferences": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "events": {
      "title": "Event",
      "description": "Campus event details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "format": "date-time" },
        "registrationDeadline": { "type": "string" },
        "venue": { "type": "string", "maxLength": 200 },
        "mapUrl": { "type": "string", "maxLength": 500 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "organizerName": { "type": "string", "maxLength": 120 },
        "societyId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "enum": ["free", "paid"] },
        "fee": { "type": "number" },
        "couponCost": { "type": "number" },
        "maxCoupons": { "type": "number" },
        "registrationLimit": { "type": "number" },
        "registeredCount": { "type": "number" },
        "allowWaitlist": { "type": "boolean" },
        "waitlistCount": { "type": "number" },
        "posterUrl": { "type": "string", "maxLength": 700000 },
        "galleryUrls": { "type": "array", "items": { "type": "string" } },
        "schedule": { "type": "array" },
        "speakers": { "type": "array" },
        "requirements": { "type": "string", "maxLength": 2000 },
        "slug": { "type": "string", "maxLength": 220 },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "completed"] },
        "isCancelled": { "type": "boolean" },
        "cancellationReason": { "type": "string", "maxLength": 500 },
        "hasFoodCoupon": { "type": "boolean" },
        "isCanteenPaymentDone": { "type": "boolean" },
        "qrVisible": { "type": "boolean" },
        "qrExpiry": { "type": "string" },
        "qrScanLimit": { "type": "number" },
        "qrScanStart": { "type": "string" },
        "qrScanEnd": { "type": "string" },
        "couponsDistributed": { "type": "boolean" },
        "upiId": { "type": "string", "maxLength": 120 }
      },
      "required": ["title", "description", "date", "venue", "organizerId", "category", "type", "registrationLimit", "registeredCount", "status"]
    },
    "registrations": {
      "title": "Registration",
      "description": "Student registration for an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected", "waitlisted"] },
        "paymentId": { "type": "string" },
        "transactionId": { "type": "string" },
        "paymentScreenshot": { "type": "string" },
        "ticketId": { "type": "string" },
        "attended": { "type": "boolean" },
        "couponRedeemed": { "type": "boolean" },
        "couponRedeemedAt": { "type": "string" },
        "qrCode": { "type": "string" },
        "scannedAt": { "type": "string", "format": "date-time" },
        "couponActive": { "type": "boolean" },
        "validationToken": { "type": "string" }
      },
      "required": ["userId", "eventId", "status", "attended", "couponRedeemed"]
    },
    "societies": {
      "title": "Society",
      "description": "Campus society details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 60 },
        "logoUrl": { "type": "string", "maxLength": 500000 },
        "bannerUrl": { "type": "string", "maxLength": 700000 },
        "followerCount": { "type": "number" },
        "organizerId": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "facultyCoordinator": { "type": "object" },
        "coreTeam": { "type": "array" },
        "announcements": { "type": "array" },
        "galleryUrls": { "type": "array" }
      },
      "required": ["name", "description", "category", "organizerId"]
    },
    "society_applications": {
      "title": "SocietyApplication",
      "description": "Student membership applications to campus societies",
      "type": "object",
      "properties": {
        "societyId": { "type": "string", "maxLength": 128 },
        "societyName": { "type": "string", "maxLength": 150 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "roleInterest": { "type": "string", "maxLength": 120 },
        "statement": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["societyId", "organizerId", "userId", "userName", "roleInterest", "status", "createdAt"]
    },
    "certificate_campaigns": {
      "title": "CertificateCampaign",
      "description": "Organiser digital certificate template campaign linked to an event",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "eventTitle": { "type": "string", "maxLength": 200 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "societyId": { "type": "string", "maxLength": 128 },
        "templateCategory": { "type": "string", "maxLength": 120 },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1200 },
        "issuingAuthority": { "type": "string", "maxLength": 200 },
        "facultyCoordinator": { "type": "string", "maxLength": 150 },
        "organiserName": { "type": "string", "maxLength": 150 },
        "signatoryDesignation": { "type": "string", "maxLength": 150 },
        "issueDate": { "type": "string", "maxLength": 64 },
        "publishedCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["eventId", "eventTitle", "organizerId", "templateCategory", "orientation", "title", "issuingAuthority", "issueDate"]
    },
    "certificates": {
      "title": "IssuedCertificate",
      "description": "Verifiable issued digital certificate without private PII",
      "type": "object",
      "properties": {
        "certificateId": { "type": "string", "maxLength": 128 },
        "campaignId": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "eventTitle": { "type": "string", "maxLength": 200 },
        "registrationId": { "type": "string", "maxLength": 160 },
        "userId": { "type": "string", "maxLength": 128 },
        "holderName": { "type": "string", "maxLength": 120 },
        "organizerId": { "type": "string", "maxLength": 128 },
        "issuingAuthority": { "type": "string", "maxLength": 200 },
        "templateCategory": { "type": "string", "maxLength": 120 },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "title": { "type": "string", "maxLength": 200 },
        "issueDate": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["valid", "revoked"] },
        "revokedReason": { "type": "string", "maxLength": 500 },
        "issuedAt": { "type": "string" }
      },
      "required": ["certificateId", "campaignId", "eventId", "eventTitle", "registrationId", "userId", "holderName", "organizerId", "issuingAuthority", "templateCategory", "status", "issuedAt"]
    },
    "audit_logs": {
      "title": "AuditLog",
      "description": "Immutable operational and revocation audit trail",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "action": { "type": "string", "maxLength": 120 },
        "targetType": { "type": "string", "maxLength": 60 },
        "targetId": { "type": "string", "maxLength": 160 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["actorId", "actorName", "action", "targetType", "targetId", "details", "createdAt"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Attendance log for events",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "scanTime": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["userId", "eventId", "scanTime"]
    },
    "coupons": {
      "title": "CouponRedemption",
      "description": "Log of food coupon redemptions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "vendorId": { "type": "string" }
      },
      "required": ["userId", "eventId", "redeemedAt", "vendorId"]
    },
    "payments": {
      "title": "CanteenPayment",
      "description": "Payment from organizer to canteen vendor",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "eventTitle": { "type": "string" },
        "organizerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorUpiId": { "type": "string" },
        "amount": { "type": "number" },
        "studentCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "paid", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" },
        "razorpayPaymentId": { "type": "string" },
        "upiTransactionId": { "type": "string" },
        "paymentScreenshot": { "type": "string" }
      },
      "required": ["eventId", "organizerId", "amount", "status", "requestedAt"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Role-based real-time notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 60 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read"]
    },
    "settings": {
      "title": "PlatformSettings",
      "description": "Super admin global platform settings",
      "type": "object",
      "properties": {
        "requireStudentApproval": { "type": "boolean" },
        "requireOrganizerApproval": { "type": "boolean" },
        "requireCanteenApproval": { "type": "boolean" },
        "platformUpiId": { "type": "string" },
        "supportEmail": { "type": "string" },
        "appsScriptUrl": { "type": "string" },
        "lastSheetsSyncAt": { "type": "string" },
        "lastSheetsSyncStatus": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "User profiles"
    },
    "events/{eventId}": {
      "schema": "events",
      "description": "Event documents"
    },
    "registrations/{registrationId}": {
      "schema": "registrations",
      "description": "Event registrations"
    },
    "societies/{societyId}": {
      "schema": "societies",
      "description": "Society documents"
    },
    "society_applications/{applicationId}": {
      "schema": "society_applications",
      "description": "Society membership applications"
    },
    "certificate_campaigns/{campaignId}": {
      "schema": "certificate_campaigns",
      "description": "Digital certificate templates and campaigns"
    },
    "certificates/{certificateId}": {
      "schema": "certificates",
      "description": "Verifiable issued digital certificates"
    },
    "audit_logs/{logId}": {
      "schema": "audit_logs",
      "description": "Immutable admin & certificate audit logs"
    },
    "attendance/{attendanceId}": {
      "schema": "attendance",
      "description": "Attendance logs"
    },
    "coupons/{couponId}": {
      "schema": "coupons",
      "description": "Coupon redemptions"
    },
    "payments/{paymentId}": {
      "schema": "payments",
      "description": "Canteen payments"
    },
    "notifications/{notificationId}": {
      "schema": "notifications",
      "description": "User notifications"
    },
    "settings/{settingId}": {
      "schema": "settings",
      "description": "Platform configuration"
    }
  }
}
