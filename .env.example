# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Razorpay Keys (Configure in AI Studio Secrets)
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# Google Apps Script URL (For Sheets sync & Drive uploads)
APPS_SCRIPT_URL="MY_APPS_SCRIPT_URL"

# Brevo API Key & Verified Sender Email (Configure in AI Studio Secrets)
BREVO_API_KEY="MY_BREVO_API_KEY"
BREVO_SENDER_EMAIL="yugalofficial63@gmail.com"

# GitHub Pages / Static Deployment Options
# Leave VITE_BASE_PATH="/" for custom domains or "<username>.github.io" root repos, or "/<repo-name>/" for GitHub Project Pages
VITE_BASE_PATH="/"
# Optional external Express backend URL when hosted on GitHub Pages
VITE_API_BASE_URL=""
# Optional Google Apps Script /exec Web App URL for direct Sheets/Drive sync from GitHub Pages
VITE_APPS_SCRIPT_URL=""
